# WordsAPI Key (RapidAPI)
WORDS_API_KEY="your_rapidapi_wordsapi_key_here"

# DeepL Auth Key (for translation)
DEEPL_API_KEY="your_deepl_auth_key_here"

# OpenAI API Key (Fallback for generating missing example sentences)
OPENAI_API_KEY="your_openai_api_key_here"

# Upstash Redis (For Rate Limiting)
UPSTASH_REDIS_REST_URL="your_upstash_redis_rest_url_here"
UPSTASH_REDIS_REST_TOKEN="your_upstash_redis_rest_token_here"

# Rate Limit Config (Optional, defaults applied in code if not set)
DAILY_GLOBAL_LIMIT="2450"
DAILY_IP_LIMIT="200"
